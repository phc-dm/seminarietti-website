---
import Page from './Page.astro'
import { Content as Contacts } from '../content/contacts.md'

const { frontmatter } = Astro.props
---

<Page title={frontmatter.title} description={frontmatter.description}>
    <header>
        <a href="/">&Leftarrow; &MediumSpace; Seminarietti del PHC</a>
    </header>
    <main class="seminarietto">
        <slot />
        {frontmatter.contacts !== false && <Contacts />}
    </main>
</Page>

<script>
    document.querySelectorAll("details.video-spoiler").forEach((details) => {
        details.addEventListener("toggle", () => {
            const video = details.querySelector("video")
            if (!video) return
            if (details instanceof HTMLDetailsElement && details.open) {
                video.play().catch(() => {})
            } else {
                video.pause()
            }
        })
    })
</script>
